{
  "name": "voronix-ai",
  "version": "0.1.0",
  "description": "VoroniX.ai: ИИ-ассистент поддержки и продаж для CRM VoroniX",
  "author": "Altynbekov Yernazar",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node src/server/main.ts",
    "dev": "node --watch src/server/main.ts",
    "chat": "node src/cli/chat.ts",
    "demo:step1": "node src/demo/before-after.ts",
    "proof:step1": "node src/proof/step1.ts",
    "prompt:show": "node src/cli/show-prompt.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "minimatch": "11.0.8"
  }
}
