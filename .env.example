# Скопируйте в .env и вставьте свой ключ. Файл .env в git не попадает.
ANTHROPIC_API_KEY=

# Необязательно: переопределить модель и усилие из config/assistant.json
# VORONIX_MODEL=claude-opus-5-5
# VORONIX_EFFORT=medium

# Пароль сотрудника для консоли и роли manager (не короче 8 символов). Пусто: вход выключен.
VORONIX_MANAGER_PASSWORD=

# Личные входы сотрудников: логин:роль:пароль через ";". Роли: operator, manager, owner. Пароль от 8 символов.
# Пример: owner:owner:пароль-владельца;aliya:operator:пароль-оператора
VORONIX_STAFF=
# Секрет подписи токенов (32+ символов). Пусто: случайный при каждом запуске, токены сбрасываются после перезапуска.
VORONIX_TOKEN_SECRET=
# Срок жизни токена сотрудника, секунд (по умолчанию 8 часов).
VORONIX_TOKEN_TTL_SEC=

# Подключение к CRM VoroniX как третий ИИ: тот же ключ (16+ символов) задаётся в CRM как VORONIXAI_KEY.
VORONIX_CRM_KEY=
